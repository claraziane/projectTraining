clear all;
close all;
clc;

% Declare paths
pathResults = ('/Users/claraziane/Library/CloudStorage/OneDrive-UniversitedeMontreal/Projets/projectTraining/Results/');
addpath('/Users/claraziane/Documents/Académique/Informatique/projectFig/'); %Functions for figures

Participants = {'P04'; 'P07'; 'P10'; 'P11'; 'P12'; 'P13'; 'P16'; 'P18'; 'P21'; 'P23'; 'P25'; 'P26'; 'P27'; 'P29'; 'P36'; 'P37'; 'P39'; 'P40'; 'P41'; 'P44'}; %FB

Sessions     = {'RW'; 'FB'};
Conditions   = {'TapSP';  'TapST';  'TapDT';
               'WalkSP'; 'WalkST'; 'WalkDT'};
figLabels    = {'TapSP';  'TapST';  'TapDT'; 'WalkSP'; 'WalkST'; 'WalkDT'; 'TapSP';  'TapST';  'TapDT'; 'WalkSP'; 'WalkST'; 'WalkDT'};
Comparisons  = {'pre'; 'post'};
 
% Preallocate matrix
imiCV      = nan(length(Participants),length(Conditions)*length(Comparisons), length(Sessions));
imiMean    = nan(length(Participants),length(Conditions)*length(Comparisons), length(Sessions));
cadence    = nan(length(Participants),length(Conditions)*length(Comparisons), length(Sessions));

for iSession = 1:length(Sessions)
    iPlot = 1;

    for iCondition = 1:length(Conditions)

        for iParticipant = 1:length(Participants)

            % Load data
            pathImport = [pathResults Participants{iParticipant} '/' Sessions{iSession} '/Behavioural/'];
            load([pathImport 'resultsBehav.mat']);

            for iCompare = 1:length(Comparisons)
                condName = [Comparisons{iCompare} Conditions{iCondition}];

                imiCV(iParticipant, iPlot+iCompare-1, iSession)   = resultsBehav.(condName).imiCV;
                imiMean(iParticipant, iPlot+iCompare-1, iSession) = resultsBehav.(condName).imiMean;
                cadence(iParticipant, iPlot+iCompare-1, iSession) = resultsBehav.(condName).cadence;

            end % End Comparisons

            if iParticipant == length(Participants)
                iPlot = iPlot + 2;
            end

        end % End Participants

    end % End Conditions

    % Replace outliers with NaNs
    [imiMean(:,:,iSession)] = removeOutliers(imiMean(:,:,iSession));
    [imiCV(:,:,iSession)]   = removeOutliers(imiCV(:,:,iSession));
    [cadence(:,:,iSession)] = removeOutliers(cadence(:,:,iSession));

end % End Sessions

% Compute delta perf
deltaCV      = imiCV(:,2:2:end,:) - imiCV(:,1:2:end-1,:);
deltaIMI     = imiMean(:,2:2:end,:) - imiMean(:,1:2:end-1,:);
deltaCadence = cadence(:,2:2:end,:) - cadence(:,1:2:end-1,:);

% Plot both sessions side by side
plotScatter(reshape(imiCV, size(imiCV,1), [], 1), Comparisons, figLabels, 'Coefficient of Variation_{Inter-Movement Interval}');
plotScatter(reshape(imiMean, size(imiMean,1), [], 1), Comparisons, figLabels, 'Inter-Movement Interval (ms)');
plotScatter(reshape(cadence, size(cadence,1), [], 1), Comparisons, figLabels, 'Cadence (movements per minute)');

plotScatter(reshape(deltaCV, size(deltaCV,1), [], 1), [], figLabels, '\Delta_{Coefficient of Variation}');
plotScatter(reshape(deltaIMI, size(deltaIMI,1), [], 1), [], figLabels, '\Delta_{Inter-Movement Interval} (ms)');
plotScatter(reshape(deltaCadence, size(deltaCadence,1), [], 1), [], figLabels, '\Delta_{Cadence} (movements per minute)');

saveas(figure(1), [pathResults 'All/Behavioural/fig_mvtCV_noOutliers.png'])
saveas(figure(2), [pathResults 'All/Behavioural/fig_mvtIMI_noOutliers.png'])
saveas(figure(3), [pathResults 'All/Behavioural/fig_mvtCadence_noOutliers.png'])

saveas(figure(4), [pathResults 'All/Behavioural/fig_deltaCV_noOutliers.png'])
saveas(figure(5), [pathResults 'All/Behavioural/fig_deltaIMI_noOutliers.png'])
saveas(figure(6), [pathResults 'All/Behavioural/fig_deltaCadence_noOutliers.png'])

close all;